# Run ./generate-secrets.ps1 to produce modules/.env with fresh values for the keys below
MSSQL_SA_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

BACKEND_ASPNETCORE_ENVIRONMENT=Production
NGINX_PORT=1139
BACKEND_PORT=8080
MCP_PORT=8090
BACKEND_ASPNETCORE_URLS=http://+:${BACKEND_PORT}
BACKEND_MCP_URLS=http://+:${MCP_PORT}
BACKEND_CONNECTION_STRING=Server=sqlserver,1433;Database=Riter;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=true
BACKEND_REDIS_CONNECTION=riter-redis:6379

Host__Infrastructure__UseRedis=true
Host__Infrastructure__TokenCleanupIntervalMinutes=60
Host__Infrastructure__EnableAutoMigration=true
Host__Infrastructure__RecordingWatchdogIntervalMinutes=60
Host__Infrastructure__RecordingStaleAfterMinutes=30

Host__Security__Cors__AllowedOrigins__0=http://localhost:${NGINX_PORT}
Host__Security__Cors__AllowedOrigins__1=

Host__Security__Jwt__SecretKey=change-me
Host__Security__Jwt__EncryptionKey=change-me
Host__Security__Jwt__Issuer=Riter.BackEnd
Host__Security__Jwt__Audience=Riter.Client
Host__Security__Jwt__ExpiryMinutes=600
Host__Security__Jwt__RefreshTokenExpiryDays=30
Host__Security__Jwt__RefreshTokenSecret=change-me

Instance__Domain__PanelUrl=http://localhost:${NGINX_PORT}
Instance__Domain__ServiceBaseUrl=http://localhost:${NGINX_PORT}/backend