# Public HTTP port for the API gateway + React panel
NGINX_PORT=3000

# Passwords are interpolated into a database URL. Keep them URL-safe: letters, digits, "-" and "_".
POSTGRES_USER=transcription
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transcription

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=transcriptions

# JWT auth for the React panel (required)
JWT_SECRET=change-me-jwt
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=مدیر
CORS_ORIGINS=http://localhost:3000,http://172.31.51.90:3000

# Hugging Face token. Accept the terms for pyannote/speaker-diarization-community-1
# (and the models it depends on) before the first diarized job.
HF_TOKEN=
# If Hugging Face downloads are slow, try https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co

# Shared L4: medium + int8_float16 leaves VRAM for the LLM. One job runs at a time.
# Use large-v3 and float16 only when the LLM is idle or moved to another GPU.
# Use a Hugging Face id (medium) or a local faster-whisper folder path.
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_BATCH_SIZE=4
# Wait to start a job until this much VRAM is free, so the LLM is not evicted.
MIN_FREE_VRAM_MB=4096
DIARIZE_MODEL=

# Existing OpenAI-compatible LLM (vLLM or similar). Leave the URL blank to skip summaries.
# From this Compose network, a server on the host is http://host.docker.internal:<port>/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Nginx allows uploads up to 1024 MB. Raise conf.d/default.conf if you exceed that.
MAX_UPLOAD_MB=500
MAX_QUEUE_DEPTH=20
